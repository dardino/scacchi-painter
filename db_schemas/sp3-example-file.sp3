      "htmlSolution": "<p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 14pt;\">  </span><span style=\"font-weight: bold; font-family: &quot;Liberation Mono&quot;; font-size: 14pt;\">1...Sh4-f5 [A]  2.Rh5-h4 Sg2-e3 [B] (Sg2-f4?)  3.Rh4-b4 Rb8-c8 #</span></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 14pt;\">  </span><span style=\"font-weight: bold; font-family: &quot;Liberation Mono&quot;; font-size: 14pt;\">1...Sg2-e3 [B]  2.Bf1-g2 Sh4-f5 [A] (Sh4-f3?)  3.Bg2-c6 Bd8*e7 #</span><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 14pt;\"> </span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 13pt;\">Umnov bicolore</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 13pt;\">Anti-duale</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 13pt;\">Inversione di ruoli tra i pezzi mattanti</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 13pt;\">Meredith</span></p><p></p><p></p>",

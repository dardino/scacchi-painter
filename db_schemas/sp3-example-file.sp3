      "htmlSolution": "<p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">BeginProblem</span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">Pieces</span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">White Ba6 Rc1 Ka8 Be1 Ph4 </span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">Black Rf4 Kg4 Pc4 Ph5 Rf5 Ph3 </span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">Stipulation H#2</span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">Option Try NoBoard Variations SetPlay</span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">Twin Move h5 f3</span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">EndProblem</span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">Execute command: pywin64.exe tmp</span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">Popeye Windows-64Bit v4.55 (748 MB)</span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">a)</span></p><p></p><p></p><p><span style=\"font-family: &quot;DejaVu Sans&quot;; font-size: 10pt;\">  1.Rf4-f3 Rc1*c4 +   2.Rf5-f4 Ba6-c8 #</span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">b) bPh5--&gt;f3</span></p><p></p><p></p><p><span style=\"font-family: &quot;DejaVu Sans&quot;; font-size: 10pt;\">  1.Rf5-h5 Ba6-c8 +   2.Rf4-f5 Rc1*c4 # </span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">solution finished. Time = 0.091 s</span></p><p></p><p></p><p></p>",

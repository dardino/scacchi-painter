      "htmlSolution": "<p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">a) </span></p><p></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.Ke6-d7 Rg1-c1   2.e7-e6 Rc1-c7 # </span></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">b) rotate 90</span></p><p></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.Kc5-b6 Rh7*a7   2.c6-c5 Ra3*a6 # </span></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">c) rotate 180</span></p><p></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.Kd3-c4 Rb8-b5   2.d4-d3 Rf1-f4 # </span></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">d) rotate 270</span></p><p></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.Kf4-e5 Ra2*a7   2.f5-f4 Ra7-a5 # </span></p><p></p>",

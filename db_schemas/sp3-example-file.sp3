      "htmlSolution": "<p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">   1.Bd5-g8 ? threat:</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">          2.Rd3-d5 #</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">      1...Sc6-~</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">          2.Sd2-b3 +</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">              2...c4*b3</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">                  3.Rd3-c3 #</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">      1...Sc6-d4</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">          2.Rd3*d4 threat:</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">                  3.Rd4*c4 #</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">              2...Ba8-d5</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">                  3.Rd4*d5 #</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">    but</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">      1...Sc6-e5 !</span></p><p></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">   1.Bd5-e6 ! threat:</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">          2.Rd3-d5 #</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">      1...Sc6-~</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">          2.Sd2-b3 [A] +</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">              2...c4*b3</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">                  3.Rd3-c3 [B] #</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">      1...Sc6-d4</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">          2.Rd3*d4 threat:</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">                  3.Rd4*c4 #</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">              2...Ba8-d5</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">                  3.Rd4*d5 #</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">      1...Sc6-e5</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">          2.Rd3-c3 [B] threat:</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">                  3.Sd2-b3 # [A]</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">              2...e3*d2</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">                  3.Be1-f2 #</span></p><p></p><p></p>",

      "htmlSolution": "<p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">a) </span></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.rLIc5-g1 LIh3-b3   2.kQf4*e3 LIb3-b1 # </span></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">b) wKc1--&gt;d8</span></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.rLIc5-h5 LIh3-c8   2.kQf4*f5 LIc8-e8 # </span></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">Royal Lion: c5</span></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">Kamikaze: f4</span></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">Lion: h3</span></p><p></p><p></p>",

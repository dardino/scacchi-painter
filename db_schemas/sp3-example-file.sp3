      "htmlSolution": "<p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">BeginProblem</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Pieces</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">White Sc6 Pb5 Pf5 Re4 Pb3 Kh3 Pg2 </span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Black Qb8 Re8 Ba7 Pd7 Be6 Pa5 Kd5 Pg5 Ph5 Sd4 Ra3 </span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Stipulation H#2</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Option Try NoBoard Variations SetPlay</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">EndProblem</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Execute command: wine pywin32.exe tmp </span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Popeye Windows-32Bit v4.55 (904 MB)</span></p><p></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.Sd4*b3 g2-g3   2.Sb3-c5 Re4-d4 # </span></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.Sd4*f5 g2-g4   2.Sf5-d6 Re4-e5 # </span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">solution finished. Time = 0.240 s</span></p><p></p><p></p><p></p><p></p><p></p>",

      "htmlSolution": "<p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">BeginProblem</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Pieces</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">White Bd8 Kf8 Re7 Pf5 Pb2 </span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Black Sb6 Kd6 Rd4 Bh1 </span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Stipulation H#2</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Option Try NoBoard Variations SetPlay</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Twin Move d4 d5</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Twin Move b2 b5</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">EndProblem</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Execute command: wine pywin32.exe tmp </span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Popeye Windows-32Bit v4.55 (904 MB)</span></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">a) </span></p><p></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.Bh1-c6 b2-b4   2.Rd4-d5 Bd8-c7 # </span></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">b) bRd4--&gt;d5</span></p><p></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.Rd5-c5 Kf8-e8   2.Sb6-d5 Re7-e6 # </span></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">c) wPb2--&gt;b5</span></p><p></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.Sb6-c4 Bd8-a5   2.Bh1-d5 Ba5-b4 # </span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">solution finished. Time = 1.290 s</span></p><p></p><p></p><p></p><p></p><p></p><p></p>",

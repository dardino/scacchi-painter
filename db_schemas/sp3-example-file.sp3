      "htmlSolution": "<p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">Soluzione:</span></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.Dg8-a8 ( 2.Da8-d5 # )</span></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">      1...c7-c6  2.Da8-a4 #</span></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">      1...Ad7-c6 2.Da8-a7 # (Pikabish)</span></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">      1...Ad7-e6 2.Af4-e5 #</span></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">      1...Te7-e6 2.Cg3*f5 # (Grimshaw)</span></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">      1...Te7-e5 2.Af4*e5 #</span></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">      1...Te7*f7 2.Af4-e5 #</span></p><p></p>",

      "htmlSolution": "<p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">BeginProblem</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Pieces</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">White lia6 lic8 Kf2 Pe6 Pc4 Bg3 </span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Black Ke4 Pe7 Pd4 Pd3 Sb7 Bf5 </span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Stipulation H#2</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Option Try NoBoard Variations</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">EndProblem</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Execute command: wine pywin64.exe tmp</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Popeye Windows-64Bit v4.55 (5743 MB)</span></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.Sb7-a5 LIc8-c3   2.d4*c3 LIa6-a4 #</span></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.Sb7-d8 LIa6-f6   2.e7*f6 LIc8-e8 # </span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">solution finished. Time = 0.020 s</span></p><p></p><p></p><p></p>",

      "htmlSolution": "<p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">BeginProblem</span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">Pieces</span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">White Ke1 Rh1 Pf4 Bh3 Pc5 Pe2 Pg4 </span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">Black Kg3 Pe7 Pf6 Ph4 Rc3 Se6 Sd6 Rd3 Qb3 Pc4 </span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">Stipulation H#2</span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">Option Try NoBoard Variations</span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">Twin Move e2 g7</span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">Twin Add w Bd6</span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">EndProblem</span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">Executing command: pywin32.exe tmp</span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">Popeye Windows-32Bit v4.73 (12 GB)</span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">a) </span></p><p></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 10pt;\">  1.Sd6-f5 0-0   2.Sf5-e3 Rf1-f3 #</span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">b) wPe2--&gt;g7  </span></p><p></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 10pt;\">  1.f6-f5 g7-g8=Q   2.f5*g4 Qg8*g4 #</span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">c) wBd6  </span></p><p></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 10pt;\">  1.Se6-d4 f4-f5 +   2.e7-e5 f5*e6 ep. #</span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">solution finished. Time = 0.169 s</span></p><p></p><p></p>",

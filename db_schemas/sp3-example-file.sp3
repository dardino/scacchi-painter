      "htmlSolution": "<p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">BeginProblem</span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">Pieces</span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">White Qb7 Pa6 Ka5 Pa4 Re4 Sf1 </span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">Black Bd8 Rc7 Pd7 Sb6 Kf3 Qg4 Pe2 Pg2 Rb1 </span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">Stipulation HS#3</span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">Option Try NoBoard Variations WhiteToPlay</span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">Twin Move f1 h3</span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">EndProblem</span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">Execute command: pywin32.exe tmp</span></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">Popeye Windows-32Bit v4.63 (1211 MB)</span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">a)</span></p><p></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 10pt;\">  1...Sb6-d5   2.Qb7*c7 Qg4-h5   3.Re4-f4 + Sd5*f4 #</span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">b) wSf1--&gt;h3</span></p><p></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 10pt;\">  1...Rc7-c3   2.Qb7*b6 e2-e1=B   3.Re4-e3 + Rc3*e3 #</span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 9pt;\">solution finished. Time = 2.793 s</span></p><p></p><p></p>",

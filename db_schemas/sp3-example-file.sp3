      "htmlSolution": "<p><span style=\"font-family: DengXian; font-size: 12pt;\">   1.Rf6 ! [2.Re6 #]</span></p><p></p><p><span style=\"font-family: DengXian; font-size: 12pt;\">      </span><span style=\"font-weight: bold; font-family: DengXian; font-size: 12pt;\">1...R ~ 2.Sg4 # [A]</span></p><p><span style=\"font-weight: bold; font-family: DengXian; font-size: 12pt;\">     1...Re4 2.S*f3 # [B]</span></p><p><span style=\"font-family: DengXian; font-size: 12pt;\">      1...Rf4   2.e*f4 #</span></p><p><span style=\"font-family: DengXian; font-size: 12pt;\">      1...Rd4  2.e*d4 #</span></p><p></p><p><span style=\"font-family: DengXian; font-size: 12pt;\">      </span><span style=\"font-weight: bold; font-family: DengXian; font-size: 12pt;\">1...B~ 2.S*f3 # [B]</span></p><p><span style=\"font-weight: bold; font-family: DengXian; font-size: 12pt;\">     1...Be4 2.Sg4 # [A]</span></p><p><span style=\"font-family: DengXian; font-size: 12pt;\">      1...Bd5 2.Sg6 #</span></p><p></p><p></p><p></p>",

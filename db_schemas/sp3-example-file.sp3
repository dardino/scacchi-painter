      "htmlSolution": "<p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">BeginProblem</span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">Condition PWC</span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">Pieces</span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">White Kf5 Ba8 Re1 Sd5 Se4 Pg6 Pc2 Pc3 Pe7 Pd7 Pc7 </span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">Black Kc4 Qg8 Ph7 Pc5 Pf3 Bf4 Pg5 </span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">Stipulation HS#3</span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">Option Try NoBoard Variations SetPlay</span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">Twin Move g8 h4</span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">EndProblem</span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">Execute command: pywin64.exe tmp</span></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">Popeye Windows-64Bit v4.61 (1166 MB)</span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">a)</span></p><p></p><p></p><p><span style=\"font-weight: bold; font-family: &quot;DejaVu Sans&quot;; font-size: 13pt;\">1.Re1-b1 Qg8*a8 [+wBg8]   </span></p><p><span style=\"font-weight: bold; font-family: &quot;DejaVu Sans&quot;; font-size: 13pt;\">    2.Bg8-e6 (2.Bf7?) h7-h5   </span></p><p><span style=\"font-weight: bold; font-family: &quot;DejaVu Sans&quot;; font-size: 13pt;\">         3.Sd5-f6 + Qa8-d5#</span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">b) bQg8--&gt;h4</span></p><p></p><p></p><p><span style=\"font-weight: bold; font-family: &quot;DejaVu Sans&quot;; font-size: 13pt;\">1.Ba8-c6 Qh4*e1 [+wRh4]   </span></p><p><span style=\"font-weight: bold; font-family: &quot;DejaVu Sans&quot;; font-size: 13pt;\">    2.Rh4*f4 [+bBh4] g5-g4   </span></p><p><span style=\"font-weight: bold; font-family: &quot;DejaVu Sans&quot;; font-size: 13pt;\">        3.Se4-f6 + (3.Sg5?) Qe1-e4#</span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;DejaVu Sans&quot;; font-size: 9pt;\">solution finished. Time = 22.791 s</span></p><p></p><p></p><p></p><p></p>",

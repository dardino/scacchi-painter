      "htmlSolution": "<p></p><p><span style=\"font-family: &quot;DejaVu Sans&quot;; font-size: 10pt;\">      1...Re4*e6 [a]    2.Rb4*c4 # [A]</span></p><p><span style=\"font-family: &quot;DejaVu Sans&quot;; font-size: 10pt;\">      1...Bd5*e6 [b]    2.Sd3-e5 # [B]</span></p><p></p><p></p><p><span style=\"font-family: &quot;DejaVu Sans&quot;; font-size: 10pt;\">  1.Qg2*g6 ! threat: 2.Qg6-e8 # </span></p><p><span style=\"font-family: &quot;DejaVu Sans&quot;; font-size: 10pt;\">      1...Re4*e6 [a]    2.Sd3-e5 # [B] </span></p><p><span style=\"font-family: &quot;DejaVu Sans&quot;; font-size: 10pt;\">      1...Bd5*e6 [b]    2.Rb4*c4 # [A]</span></p><p></p><p></p><p></p>",

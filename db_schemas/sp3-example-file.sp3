      "htmlSolution": "<p><span style=\"font-weight: bold; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">  1.d2-d3 Ba5-e1  </span></p><p><span style=\"font-weight: bold; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">      2.Ke4-e2/bBe1-e3 Kh6-f4/bBe3-g5  </span></p><p><span style=\"font-weight: bold; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">          3.Ke2-d2 h7-h6</span></p><p><span style=\"font-weight: bold; font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">              4.Kd2-c1 Kf4-f3 #</span></p><p></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">  (1.d2-d4? Ba5-e1   </span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">          2.Ke4-e2/bBe1-e3 Kh6-f4/bBe3-g5</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">                 3.Ke2-d2 h7-h6</span></p><p><span style=\"font-family: &quot;Microsoft Sans Serif&quot;; font-size: 13pt;\">                       4.Kd2-c1 Kf4-e4+!! 5. f4)</span></p><p></p><p></p><p></p>",

      "htmlSolution": "<p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">BeginProblem</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Pieces</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">White Bb7 Pc6 Pb5 Kd5 Sg4 Re2 </span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Black Bb8 Pc5 Sd4 Pf4 Kf3 </span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Stipulation H#2</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Option Try NoBoard Variations SetPlay</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Twin Move c5 g3</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Twin Move b8 e1</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Twin Move b8 f5</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">EndProblem</span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Execute command: wine pywin32.exe tmp </span></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">Popeye Windows-32Bit v4.55 (904 MB)</span></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">a) </span></p><p></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.Sd4-f5 Bb7-c8   2.Sf5-g3 Re2-f2 # </span></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">b) bPc5--&gt;g3</span></p><p></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.Sd4*b5 Bb7-a6   2.Sb5-d6 Sg4-e5 # </span></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">c) bBb8--&gt;e1</span></p><p></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.Sd4*c6 Re2-g2   2.Sc6-e5 Kd5*e5 # </span></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">d) bBb8--&gt;f5</span></p><p></p><p></p><p><span style=\"font-family: &quot;Liberation Mono&quot;; font-size: 11pt;\">  1.Sd4*e2 Kd5-c4   2.Kf3-e4 c6-c7 # </span></p><p></p><p><span style=\"font-style: italic; font-family: &quot;Liberation Mono&quot;; font-size: 10pt;\">solution finished. Time = 0.230 s</span></p><p></p><p></p><p></p><p></p><p></p>",

{
  "name": "sp-gui-angular",
  "version": "0.2.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "debugger": "pnpm remotedebug_ios_webkit_adapter --port 9000",
    "tunnel": "pnpm lt --port 4200 --local-https true --allow-invalid-cert -o",
    "debug": "pnpm concurrently --kill-others \"pnpm debugger\" \"pnpm tunnel\"",
    "startinsecure": "pnpm ng serve --configuration tauri --host=0.0.0.0 --disable-host-check",
    "start:pwa": "pnpm start --configuration production",
    "start": "pnpm ng serve --ssl true --host=0.0.0.0 --disable-host-check",
    "build": "pnpm ng build gui --configuration production",
    "build:tauri": "env-cmd -f .tauri.env pnpm ng build gui -c tauri",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm ng lint",
    "e2e": "pnpm ng e2e",
    "build:stats": "pnpm build --stats-json",
    "analyze": "webpack-bundle-analyzer dist/gui/stats.json",
    "build:Azure": "pnpm tsc --version && pnpm ng version && pnpm build"
  },
  "private": true,
  "dependencies": {
    "@dardino-chess/core": "workspace:*",
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.0.0",
    "@azure/data-tables": "^13.3.0",
    "@azure/functions": "^4.11.2",
    "@azure/msal-angular": "^6.1.0",
    "@azure/msal-browser": "^5.19.0",
    "@microsoft/microsoft-graph-client": "^3.0.5",
    "@standard-schema/spec": "^1.0.0",
    "@tauri-apps/api": "^2.11.1",
    "@dardino/chess-board": "^0.1.1",
    "file-saver": "^2.0.5",
    "marked": "18.0.10",
    "marked-base-url": "^1.1.3",
    "ngx-editor": "18.0.0",
    "prosemirror-model": "^1.21.0",
    "rtf.js": "^3.0.9",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.0",
    "@angular-devkit/architect": "^0.2201.5",
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular-devkit/core": "^22.0.0",
    "@angular-devkit/schematics": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/language-service": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@microsoft/microsoft-graph-types": "^2.6.0",
    "@stylistic/eslint-plugin": "^5.7.1",
    "@types/file-saver": "^2.0.3",
    "@types/node": "26.2.0",
    "@types/wicg-file-system-access": "2023.10.6",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "angular-eslint": "22.1.0",
    "baseline-browser-mapping": "^2.9.19",
    "concurrently": "10.0.5",
    "env-cmd": "^11.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "64.2.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "globals": "^17.0.0",
    "jsdom": "^30.0.1",
    "localtunnel": "^2.0.2",
    "ng-packagr": "^22.0.0",
    "remotedebug-ios-webkit-adapter": "^0.4.2",
    "ts-node": "^10.9.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.33.1",
    "vite-node": "^6.0.0",
    "vitest": "^4.0.15"
  },
  "packageManager": "pnpm@10.33.0"
}

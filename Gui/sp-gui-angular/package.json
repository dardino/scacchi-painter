{
  "name": "sp-gui-angular",
  "version": "0.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "debugger": "pnpm remotedebug_ios_webkit_adapter --port 9000",
    "tunnel": "pnpm lt --port 4200 --local-https true --allow-invalid-cert -o",
    "debug": "pnpm concurrently --kill-others \"pnpm debugger\" \"pnpm tunnel\"",
    "startinsecure": "pnpm ng serve --configuration tauri --host=0.0.0.0 --disable-host-check",
    "start:pwa": "pnpm start --configuration production",
    "start": "pnpm ng serve --ssl true --host=0.0.0.0 --disable-host-check",
    "build": "pnpm ng build gui --configuration production",
    "build:tauri": "env-cmd -f .tauri.env pnpm ng build gui -c tauri",
    "test": "pnpm vitest",
    "test:ui": "pnpm vitest --ui",
    "test:ci": "pnpm vitest run && pnpm tsc -b tsconfig.json",
    "test:coverage": "pnpm vitest run --coverage",
    "lint": "pnpm ng lint",
    "e2e": "pnpm ng e2e",
    "build:stats": "pnpm build --stats-json",
    "analyze": "webpack-bundle-analyzer dist/gui/stats.json",
    "build:Azure": "pnpm tsc --version && pnpm ng version && pnpm build"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@angular/service-worker": "^22.2.6",
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.17.1",
    "@azure/msal-angular": "^6.3.2",
    "@azure/msal-browser": "^5.29.1",
    "@dardino-chess/core": "workspace:*",
    "@dardino/chess-board": "^0.2.1",
    "@microsoft/microsoft-graph-client": "^3.1.0",
    "@standard-schema/spec": "^1.1.0",
    "@tauri-apps/api": "^2.12.5",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "marked": "18.2.0",
    "marked-base-url": "^1.1.11",
    "ngx-editor": "19.1.1",
    "prosemirror-model": "^1.25.13",
    "rtf.js": "^3.0.9",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.7",
    "@angular-devkit/architect": "^0.2202.7",
    "@angular-devkit/build-angular": "^22.2.7",
    "@angular-devkit/core": "^22.2.7",
    "@angular-devkit/schematics": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/language-service": "^22.2.6",
    "@eslint/js": "^10.0.1",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@stylistic/eslint-plugin": "^6.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "26.6.6",
    "@types/wicg-file-system-access": "2023.10.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "angular-eslint": "22.6.0",
    "baseline-browser-mapping": "^2.11.38",
    "concurrently": "^10.0.7",
    "env-cmd": "^11.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "65.4.7",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "localtunnel": "^2.0.2",
    "ng-packagr": "^22.2.6",
    "remotedebug-ios-webkit-adapter": "^0.4.2",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
